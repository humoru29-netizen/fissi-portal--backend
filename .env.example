# Copy this file to .env and fill in real values. Never commit .env itself.

# Neon.tech PostgreSQL connection string
# Get this from your Neon dashboard -> Connection Details -> Pooled connection
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/fissi_portal?sslmode=require"

# JWT
JWT_SECRET="replace-this-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=production

# CORS - your deployed frontend URL(s), comma separated
CORS_ORIGIN="https://your-frontend.netlify.app,http://localhost:5173"
